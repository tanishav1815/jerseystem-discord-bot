# --- Discord Credentials ---
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
WEBHOOK_URL=your_google_apps_script_webhook_url_here

# --- Database Credentials (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=discord_bot

# --- RBAC Role Names (must match exact Discord role names) ---
ADMIN_ROLE_NAME=Admin
INSTRUCTOR_ROLE_NAME=Program Instructor
ADMIN_USER_IDS=comma_separated_discord_user_ids_here

# --- Salesforce Credentials (if using CRM sync) ---
SF_LOGIN_URL=https://test.salesforce.com
SF_USERNAME=your_salesforce_username
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_salesforce_security_token

# --- Google Docs & Sheets Integration (Knowledge Base) ---
# Comma-separate multiple Google Document IDs
GOOGLE_DOC_IDS=your_google_doc_id_here
# Format: sheet_id|gid, sheet_id|gid
GOOGLE_SHEET_IDS=your_sheet_id|0,your_sheet_id|gid

# --- Gemini API Key (AI Chatbot) ---
GEMINI_API_KEY=your_gemini_api_key_here
